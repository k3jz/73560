--// Roblox Lua Script - Toggleable CFrame Speed Walk with Customizable Key and Speed Slider

-- Services
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

-- Variables
getgenv().cframeSpeedEnabled = false
getgenv().cframeSpeedKeybindActive = false
getgenv().cframeSpeed = 16  -- Default speed

-- GUI Setup
uhhh:AddSlider("CFrameSpeedSlider", {
    Text = "CFrame Speed",
    Default = 16,
    Min = 1,
    Max = 100,
    Rounding = 0,
    Callback = function(value)
        getgenv().cframeSpeed = value
    end
})

uhhh:AddToggle('CFrameSpeedToggle', {
    Text = 'CFrame Speed Walk',
    Default = false,
    Callback = function(state)
        getgenv().cframeSpeedEnabled = state
        if not state then getgenv().cframeSpeedKeybindActive = false end
    end,
}):AddKeyPicker('CFrameSpeedKeybind', {
    Default = 'T',
    Text = 'Toggle CFrame Speed Walk',
    Mode = 'Toggle',
    Callback = function(state)
        if UserInputService:GetFocusedTextBox() then return end
        getgenv().cframeSpeedKeybindActive = state
    end,
})

-- Movement Loop
task.spawn(function()
    while task.wait(0) do
        local character = player.Character
        local humanoid = character and character:FindFirstChild("Humanoid")
        if getgenv().cframeSpeedEnabled and getgenv().cframeSpeedKeybindActive and character and humanoid and humanoid.MoveDirection.Magnitude > 0 then
            local moveDirection = humanoid.MoveDirection.Unit
            local speed = getgenv().cframeSpeed
            local deltaTime = task.wait()
            character:TranslateBy(moveDirection * speed * deltaTime)
        end
    end
end)
